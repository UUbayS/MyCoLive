# Caddyfile - reverse proxy untuk MyCoLive
# HTTP only (akses via IP publik, tanpa domain/TLS)

:80 {
    log {
        output stdout
    }

    # /api/* diteruskan ke backend (Hono)
    handle /api/* {
        reverse_proxy backend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Sisanya ke frontend (Next.js)
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}