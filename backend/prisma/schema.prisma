generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PEMILIK
  PENGELOLA
  PENGHUNI
}

enum StatusKamar {
  KOSONG
  TERISI
  MAINTENANCE
}

enum TipeKamar {
  REGULER
  VIP
  STUDIO
}

enum JenisProperti {
  LAKI_LAKI
  PEREMPUAN
  CAMPUR
}

enum StatusPemesanan {
  MENUNGGU
  DITERIMA
  DITOLAK
  SELESAI
}

enum StatusPembayaran {
  MENUNGGU
  DIVERIFIKASI
  DITERIMA
  DITOLAK
}

enum StatusKomplain {
  BARU
  DIPROSES
  SELESAI
}

enum JenisKomplain {
  FASILITAS
  LINGKUNGAN
  PENGHUNI_LAIN
  LAINNYA
}

enum StatusDana {
  MENUNGGU
  DITERIMA
  DITOLAK
}

enum StatusSewa {
  AKTIF
  PENGAJUAN_CHECKOUT
  BERAKHIR
}

enum StatusPengajuanCheckout {
  MENUNGGU
  DITERIMA
  DITOLAK
}

enum JenisFasilitas {
  RUANGAN
  UMUM
}

model User {
  id        String   @id @default(cuid())
  username  String
  email     String
  password  String
  nama      String
  role      Role
  no_telepon String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  penghuni    Penghuni?
  operator   Operator[]

  // Relation opposite: PEMILIK owns properti
  properti  Properti[]
  // Relation opposite: settings
  settings   AdminSettings?
  // Relation opposite: admin yang memproses checkout
  pengajuanCheckoutAdmin PengajuanCheckout[]
  pengumuman             Pengumuman[]

  @@unique([username], map: "User_username_key", where: { deleted_at: null })
  @@unique([email], map: "User_email_key", where: { deleted_at: null })
  @@unique([no_telepon], map: "User_no_telepon_key", where: { deleted_at: null })
}

model AdminSettings {
  id            String   @id @default(cuid())
  nama_rekening String?
  nomor_rekening String?
  bank          String?
  qris_image    String?
  updated_at   DateTime @updatedAt

  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [id])
}

model Fasilitas {
  id         String        @id @default(cuid())
  nama       String
  jenis      JenisFasilitas
  created_at DateTime      @default(now())

  kamar      Kamar[]
  properti   Properti[]
}

model Properti {
  id          String   @id @default(cuid())
  nama        String
  alamat      String
  provinsi    String?
  kota        String?
  kecamatan   String?
  kode_pos    String?
  detail_alamat String?
  jenis       JenisProperti?
  deskripsi   String?
  kebijakan  String?
  gambar     String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  admin_id   String
  admin      User     @relation(fields: [admin_id], references: [id])

  kamar      Kamar[]
  komplain   Komplain[]
  operator   Operator[]
  pemesanan  Pemesanan[]
  pengajuanDana PengajuanDana[]
  pengajuanCheckout PengajuanCheckout[]
  fasilitas_umum Fasilitas[]
  pengumuman        Pengumuman[]
}

model Kamar {
  id          String   @id @default(cuid())
  nomor       String
  tipe        TipeKamar @default(REGULER)
  luas        String?
  deskripsi   String?
  tarif      Json?
  gambar     String[]
  status     StatusKamar @default(KOSONG)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  properti_id String
  properti    Properti @relation(fields: [properti_id], references: [id])

  pemesanan    Pemesanan[]
  penghuni     Penghuni?
  pengajuanCheckout PengajuanCheckout[]
  fasilitas_ruangan Fasilitas[]

  @@unique([properti_id, nomor], where: { deleted_at: null })
}

model Pemesanan {
  id              String   @id @default(cuid())
  durasi_sewa     Int
  tgl_masuk       DateTime
  metode_bayar   String
  total_bayar    Int
  status          StatusPemesanan @default(MENUNGGU)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  kamar_id    String
  kamar       Kamar    @relation(fields: [kamar_id], references: [id])

  penghuni_id  String
  penghuni    Penghuni @relation(fields: [penghuni_id], references: [id])

  properti_id String
  properti   Properti @relation(fields: [properti_id], references: [id])

  pembayaran Pembayaran?
}

model Pembayaran {
  id              String   @id @default(cuid())
  metode_bayar    String
  bukti           String?
  status          StatusPembayaran @default(MENUNGGU)
  tgl_bayar       DateTime?
  nomor_kuitansi  String?  @unique
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  pemesanan_id String   @unique
  pemesanan   Pemesanan @relation(fields: [pemesanan_id], references: [id])
}

model Penghuni {
  id          String   @id @default(cuid())
  tgl_mulai   DateTime
  tgl_berakhir DateTime?
  status_sewa StatusSewa @default(AKTIF)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [id])

  kamar_id    String?  @unique
  kamar      Kamar?   @relation(fields: [kamar_id], references: [id])

  pemesanan   Pemesanan[]
  komplain   Komplain[]
  pengajuanCheckout PengajuanCheckout[]
}

model Operator {
  id          String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  user_id     String
  user        User     @relation(fields: [user_id], references: [id])

  properti_id String
  properti   Properti @relation(fields: [properti_id], references: [id])

  // Relation opposite
  pengajuanDana PengajuanDana[]

  @@unique([user_id, properti_id], where: { deleted_at: null })
}

model Komplain {
  id          String        @id @default(cuid())
  masalah     String
  jenis       JenisKomplain
  deskripsi   String
  foto        String?
  status      StatusKomplain @default(BARU)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  penghuni_id  String
  penghuni     Penghuni @relation(fields: [penghuni_id], references: [id])

  properti_id String
  properti   Properti @relation(fields: [properti_id], references: [id])
}

model PengajuanDana {
  id          String   @id @default(cuid())
  tujuan      String
  jumlah      Int
  no_rekening String
  foto        String?
  status      StatusDana @default(MENUNGGU)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  operator_id  String
  operator   Operator  @relation(fields: [operator_id], references: [id])

  properti_id String
  properti  Properti  @relation(fields: [properti_id], references: [id])
}

model Notifikasi {
  id          String   @id @default(cuid())
  user_id     String
  judul       String
  pesan       String
  is_read     Boolean  @default(false)
  tipe        String?
  related_id  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Pengumuman {
  id          Int      @id @default(autoincrement())
  judul       String
  isi         String
  properti_id String?
  pemilik_id  String
  created_at  DateTime @default(now())

  properti Properti? @relation(fields: [properti_id], references: [id])
  pemilik  User      @relation(fields: [pemilik_id], references: [id])
}

model PengajuanCheckout {
  id          String   @id @default(cuid())
  keterangan  String?
  status      StatusPengajuanCheckout @default(MENUNGGU)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  penghuni_id String
  penghuni    Penghuni @relation(fields: [penghuni_id], references: [id])

  kamar_id    String
  kamar       Kamar    @relation(fields: [kamar_id], references: [id])

  properti_id String
  properti    Properti @relation(fields: [properti_id], references: [id])

  admin_id    String?
  admin       User?    @relation(fields: [admin_id], references: [id])
}