# Salin file ini jadi `.env` di root project, lalu isi nilainya.
# cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=mycolive
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=comprodb

# ---------- Backend / JWT ----------
# Generate dengan: openssl rand -base64 32
JWT_SECRET=GANTI_DENGAN_RANDOM_32_BYTES_BASE64

# ---------- Frontend ----------
# URL publik yang diakses user (tanpa / di akhir).
# Contoh: http://103.xxx.xxx.xxx atau https://domain.com
NEXT_PUBLIC_API_URL=http://YOUR_VM_PUBLIC_IP